# Database — giữ nguyên nếu dùng docker-compose
DATABASE_URL=postgresql://postgres:password@db:5432/ocr_risk

# OCR provider: openrouter | nvidia | auto
OCR_PROVIDER=openrouter
OCR_CONCURRENCY=3

# OpenRouter (khuyến nghị — hỗ trợ Gemini Flash, nhanh và rẻ)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# NVIDIA NIM (thay thế nếu không dùng OpenRouter)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Upload directory
UPLOAD_DIR=./uploads

# Email thông báo (tuỳ chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
