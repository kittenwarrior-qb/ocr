# Database — giữ nguyên nếu dùng docker-compose
POSTGRES_DB=ocr_risk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@db:5432/ocr_risk

# OCR — cấu hình qua giao diện Settings (không cần điền ở đây)
# API key và model được lưu trong DB, quản lý qua UI
OCR_PROVIDER=openrouter
OCR_CONCURRENCY=3

# Upload directory
UPLOAD_DIR=./uploads
