# Database - keep these defaults when using docker-compose
POSTGRES_DB=ocr_risk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@db:5432/ocr_risk

# OCR - OpenRouter key/model are managed in the database by the backend.
# The OpenRouter UI is intentionally hidden from Settings to avoid accidental edits.
OCR_PROVIDER=openrouter
OCR_CONCURRENCY=3

# Upload directory
UPLOAD_DIR=./uploads

# Docker deploy without bundled Caddy.
# On VPS, set this to the network used by the shared Caddy container.
CADDY_NETWORK=coin-em_emcoin-network

# MISA CRM Open API
# Preferred: enter App ID and Secret in the app Settings screen.
# These env values are only fallback/bootstrap values when the DB has no MISA config yet.
# Source: MISA CRM -> Settings -> Developer -> API
APP_ID=
MISA_CLIENT_SECRET=

# MISA Kế toán (AMIS Accounting) Open API — dùng cho "Đơn mua hàng" (ĐMH).
# Để trống = dry-run (build payload + ghi JSON ra data/po_payloads/, không gọi HTTP).
# Điền đủ cả 3 để bật gọi API thật.
MISA_ACCOUNTING_BASE_URL=
MISA_ACCOUNTING_APP_ID=
MISA_ACCOUNTING_SECRET=
